# ==============================================================================
# HVAC ERP Microservices System - Master Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project Runtime & Gateway Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
PORT="3000"
GATEWAY_PORT="3000"

# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration (Local & Railway Production)
# ------------------------------------------------------------------------------
# Local Connection:
MONGO_URI="mongodb://localhost:27017/hvac_erp"

# Actual Railway Cloud Credentials:
MONGO_INITDB_ROOT_USERNAME="mongo"
MONGO_INITDB_ROOT_PASSWORD="QzCMNUHdFdIUEOBGbXGNYwgSEkWzhBhq"
MONGOHOST="mongodb.railway.internal"
MONGOPORT="27017"
MONGOUSER="mongo"
MONGOPASSWORD="QzCMNUHdFdIUEOBGbXGNYwgSEkWzhBhq"

# Railway Private URL (Inside Railway Container):
# MONGO_URI="${{MongoDB.MONGO_PRIVATE_URL}}"

# ------------------------------------------------------------------------------
# 3. Redis Cache & Distributed Lock Configuration (Local & Railway Production)
# ------------------------------------------------------------------------------
# Local Connection:
REDIS_URI="redis://localhost:6379"

# Actual Railway Cloud Credentials:
REDISUSER="default"
REDIS_PASSWORD="xiaeeZCGngcJNpJKDTCdQSEYvoKKeMDN"
REDISPASSWORD="xiaeeZCGngcJNpJKDTCdQSEYvoKKeMDN"
REDISHOST="redis.railway.internal"
REDISPORT="6379"

# Railway Private URL (Inside Railway Container):
# REDIS_URI="redis://default:xiaeeZCGngcJNpJKDTCdQSEYvoKKeMDN@redis.railway.internal:6379"

# ------------------------------------------------------------------------------
# 4. RabbitMQ Event Bus & Message Broker Configuration
# ------------------------------------------------------------------------------
# Local Connection:
RABBITMQ_URL="amqp://hvac_admin:hvac_secret_123@localhost:5672"

# Actual Railway Cloud Credentials:
RABBITMQ_DEFAULT_USER="hvac_admin"
RABBITMQ_DEFAULT_PASS="hvac_secret_123"
RABBITMQ_PORT="5672"
RABBITMQ_MANAGEMENT_PORT="15672"

# Railway Private URL (Inside Railway Container):
# RABBITMQ_URL="amqp://hvac_admin:hvac_secret_123@rabbitmq.railway.internal:5672"

# ------------------------------------------------------------------------------
# 5. Security, Cryptography & Token Secrets
# ------------------------------------------------------------------------------
JWT_SECRET="super-secret-development-jwt-key-replace-in-production-12345"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN="7d"
INTERNAL_SERVICE_SECRET="hvac-internal-signed-token-secret-minimum-32-chars"

# ------------------------------------------------------------------------------
# 6. Object Storage (S3 / MinIO) for Attachments & PDFs
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="hvac-erp-attachments"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# ------------------------------------------------------------------------------
# 7. Microservices Internal Ports (Local & Container Networking)
# ------------------------------------------------------------------------------
IDENTITY_SERVICE_PORT="4001"
INVENTORY_SERVICE_PORT="4002"
PURCHASING_SERVICE_PORT="4003"
CUSTOMER_SERVICE_PORT="4004"
SALES_SERVICE_PORT="4005"
INSTALLMENT_SERVICE_PORT="4006"
FINANCE_SERVICE_PORT="4007"
TECHNICIAN_SERVICE_PORT="4008"
SERVICE_OPERATIONS_SERVICE_PORT="4009"
APPROVAL_SERVICE_PORT="4010"
NOTIFICATION_SERVICE_PORT="4011"
AUDIT_SERVICE_PORT="4012"
REPORTING_SERVICE_PORT="4013"
