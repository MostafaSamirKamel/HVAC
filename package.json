{
  "name": "hvac-erp-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "description": "High-concurrency, event-driven HVAC ERP microservices backend",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "node scripts/prod/start-unified.mjs",
    "start:dev": "node scripts/dev/start-all.mjs --dev",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "seed": "tsx scripts/seed/seed-all.ts"
  },
  "devDependencies": {
    "@hvac/api-contracts": "workspace:*",
    "@hvac/auth-context": "workspace:*",
    "@hvac/config": "workspace:*",
    "@hvac/database": "workspace:*",
    "@hvac/errors": "workspace:*",
    "@hvac/event-contracts": "workspace:*",
    "@hvac/logger": "workspace:*",
    "@hvac/messaging": "workspace:*",
    "@hvac/money": "workspace:*",
    "@hvac/observability": "workspace:*",
    "@hvac/redis": "workspace:*",
    "@hvac/storage": "workspace:*",
    "@hvac/testing": "workspace:*",
    "@hvac/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/supertest": "^7.2.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.3",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "vitest": "^5.0.2"
  }
}
